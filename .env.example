# ArenaOS configuration — copy to .env . Secrets can also live in the encrypted vault (Settings page).
# Without ARENA_API_KEY the system boots in degraded mode (all other subsystems work; model calls raise a clear error).

ARENA_API_KEY=
# Base URL of your Arena API access. Confirm the exact base+path against your Arena account's docs;
# any OpenAI-compatible endpoint works. Per-endpoint paths are configured in data/arena_endpoints.json.
ARENA_BASE_URL=https://api.arena.ai/v1
ARENA_ENDPOINTS_PATH=data/arena_endpoints.json

# Fernet key for the encrypted secret vault. Auto-generated into data/.vault_key (0600) on first boot if empty.
SECRET_VAULT_KEY=
# Session signing secret. Auto-generated into data/.jwt_secret on first boot if empty.
JWT_SECRET=

# Platform login (single operator).
OPERATOR_PASSWORD=

# Empty = SQLite at data/arenaos.db . On Render set to your Postgres connection string.
DB_URL=
DATA_DIR=data

# Deploy manager (optional until you add a token in Settings).
RENDER_API_TOKEN=
